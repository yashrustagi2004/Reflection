# Environment Configuration for Reflection Services
# Copy this file to .env and fill in your actual values

# ==================== Shared Configuration ====================

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRY_HOURS=24

# Flask
FLASK_SECRET_KEY=your-secret-key-change-this-in-production
FLASK_DEBUG=False

# MongoDB
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=Reflection

# Service URLs
LOGIN_MANAGEMENT_URL=http://localhost:5001
FILE_PARSING_URL=http://localhost:5002
QA_GENERATION_URL=http://localhost:5003

# CORS
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# API Authentication Token (for service-to-service communication)
API_AUTH_TOKEN=my-secret-token-change-this-in-production

# ==================== File Parsing Service ====================

FILE_PARSING_PORT=5002
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Pinecone Configuration
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
# Region: Use the region where you created your index (e.g., us-east-1, us-west-2, eu-west-1)
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=interview-prep-assistant

# ==================== QA Generation Service ====================

QA_GENERATION_PORT=5003

# Google Gemini API
GOOGLE_API_KEY=your-google-gemini-api-key-here


# ==================== Login Management Service ====================

LOGIN_MANAGEMENT_PORT=5001

# OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==================== Frontend Service ====================

FRONTEND_PORT=5000

# ==================== Resources Service ====================

RESOURCES_PORT=5005
